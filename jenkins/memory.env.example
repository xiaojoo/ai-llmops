# ═════════════════════════════════════════════════════════════════════════
# jenkins/docker-compose.memory.yaml（腾讯记忆四件套）配置模板
# 用法：cp jenkins/memory.env.example jenkins/memory.env 然后填真实值
# 之后执行：./deploy-memory.sh up
# 说明：LLM 两组（MEMORY 组=记忆提取/知识 ingest；PROXY 组=proxy 转发上游）
# 可填同一套 DeepSeek/任意 OpenAI 兼容端点。
# ═════════════════════════════════════════════════════════════════════════

# ---- 镜像（可覆盖为私有仓）----
# MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
# MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
# PROXY_IMAGE=agentmemory/memory-proxy:latest

# ---- minio ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 腾讯记忆 · 端口 ----
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ---- memory 组 LLM（记忆提取 / 知识 ingest）必填 ----
MEMORY_LLM_BASE_URL=REPLACE_ME
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME
MEMORY_LLM_PROTOCOL=openai              # openai | anthropic

# ---- proxy 组 LLM（proxy 把用户请求转发到该上游）必填 ----
PROXY_UPSTREAM_URL=REPLACE_ME
PROXY_UPSTREAM_API_KEY=REPLACE_ME
PROXY_UPSTREAM_MODEL=REPLACE_ME
# proxy 能力开关：=1 一键开启 auth / sessionInit / tdai 记忆注入（默认 0 = 纯转发）
PROXY_FULL_STACK=0

# ---- 知识服务对外可达地址（必须含 /v3）----
# 默认 host.docker.internal 供容器内回环到宿主机；公网/跨机部署改成真实地址
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3
# Panel UI "客户端接入地址"卡片显示地址；留空 = 脚本自动探测宿主机 LAN IP
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.31.194:8096

# ---- 内部凭据 ----
# 留空（默认）：memory-core 关闭 Bearer gate；hub/proxy 自动用 "local"
MEMORY_CORE_GATEWAY_API_KEY=
# admin 用户名；user_key 由脚本首次启动自动生成随机 sk-mem-* 存到 .memory-admin-key
MEMORY_CORE_ADMIN_USERNAME=admin
