# ═════════════════════════════════════════════════════════════════════════
# jenkins/docker-compose.yaml 的配置模板
# 用法：cp jenkins/.env.example jenkins/.env  然后填真实值（.env 已被 gitignore）
# 敏感项必填（填 REPLACE_ME 启动会失败）；非敏感项不填用 compose 内默认值。
# ═════════════════════════════════════════════════════════════════════════

# ---- 镜像（Jenkins 流水线会自动注入 IMAGE_NAME/IMAGE_TAG）----
# IMAGE_NAME=llmops-api
# IMAGE_TAG=latest

# ---- 进程/服务模式 ----
MIGRATION_ENABLED=true
SERVER_WORKER_AMOUNT=2
SERVER_THREAD_AMOUNT=2
CELERY_POOL=threads
CELERY_WORKER_AMOUNT=2
TRANSFORMERS_OFFLINE=1

# ---- 安全 ----
JWT_SECRET_KEY=REPLACE_ME
WTF_CSRF_ENABLED=false

# ---- 数据库（llmops-db，随编排拉起）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=llmdb
POSTGRES_PORT=5432
SQLALCHEMY_DATABASE_URI=postgresql://postgres:123456@llmops-db:5432/llmdb?client_encoding=utf8&options=-csearch_path=llmops
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=true

# ---- Redis（llmops-redis）----
REDIS_HOST=llmops-redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_USE_SSL=false

# ---- Weaviate（llmops-weaviate）----
WEAVIATE_HTTP_HOST=llmops-weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=llmops-weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=REPLACE_ME

# ---- 应用对外端口 ----
LLMOPS_PORT=5001
NGINX_PORT=80

# ---- 对象存储（腾讯 COS；STORAGE_PROVIDER 走系统配置）----
COS_SECRET_ID=REPLACE_ME
COS_SECRET_KEY=REPLACE_ME
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=REPLACE_ME
COS_DOMAIN=

# ---- Celery ----
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=true
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true

# ---- GitHub OAuth（oauth_service 直读 env，web 端改无效，必须在此配）----
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_CLIENT_REDIRECT_URI=http://192.168.31.194/auth/authorize/github

# ---- 可观测/辅助 ----
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=REPLACE_ME
LANGSMITH_PROJECT=llmops
GAODE_API_KEY=REPLACE_ME
ASSISTANT_AGENT_ID=REPLACE_ME

# ---- LLM 提供方（web 端系统配置优先于此处；此处作为初始/兜底值）----
OPENAI_API_KEY=REPLACE_ME
OPENAI_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
MOONSHOT_API_KEY=REPLACE_ME
MOONSHOT_API_BASE=https://api.moonshot.cn
DASHSCOPE_API_KEY=REPLACE_ME
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
HF_HUB_OFFLINE=1   # LTP/嵌入模型离线加载（模型在宿主挂载，禁联网）

# ---- 运行时出网代理（OAuth 换 token/外网调用需走代理；内部服务名已在 NO_PROXY）----
HTTP_PROXY=http://<代理IP>:7890
HTTPS_PROXY=http://<代理IP>:7890
NO_PROXY=localhost,127.0.0.1,.local,llmops-db,llmops-redis,llmops-weaviate,llmops-api,llmops-celery,llmops-web,llmops-nginx,memory-core,memory-hub,memory-proxy,minio
