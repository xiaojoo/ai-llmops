# ═════════════════════════════════════════════════════════════════════════
# deploy/base 基础环境配置模板
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env，把 REPLACE_ME 换成你的真实值
#   ./deploy.sh up
#
# 部署内容：PostgreSQL + Redis + Weaviate + MinIO + 腾讯记忆三件套
#          (memory-core / memory-hub / memory-proxy)
# ═════════════════════════════════════════════════════════════════════════

# ── 腾讯记忆镜像（默认 Docker Hub 公开镜像；腾讯内网可覆盖为 mirrors.tencent.com 私仓）──
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=llmdb
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────
# 密码与应用侧 deploy/.env.example 默认值保持一致（REDIS_PASSWORD=123456）
REDIS_PASSWORD=123456
REDIS_PORT=6379

# ── Weaviate ───────────────────────────────────────────────────────────────
# API Key 同时用于容器内鉴权，应用侧 WEAVIATE_API_KEY 必须填同一个值
WEAVIATE_API_KEY=change-me-weaviate-key
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ── MinIO（S3 + 控制台）────────────────────────────────────────────────────
# 生产环境务必改成强密码（MinIO 要求 8 位以上）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 腾讯记忆 · memory 组（memory-core + memory-hub 内部 LLM：记忆提取 / 知识 ingest）──
# 必填，示例：https://api.deepseek.com/v1 / sk-xxx / deepseek-v4-flash
MEMORY_LLM_BASE_URL=REPLACE_ME
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME
MEMORY_LLM_PROTOCOL=openai              # openai | anthropic

# ── 腾讯记忆 · proxy 组（proxy 把用户请求转发到该上游 LLM）──
# 必填，可与 memory 组相同或不同
PROXY_UPSTREAM_URL=REPLACE_ME
PROXY_UPSTREAM_API_KEY=REPLACE_ME
PROXY_UPSTREAM_MODEL=REPLACE_ME
# proxy 能力开关：=1 一键开启 auth / sessionInit / tdai 记忆注入（默认 0 = 纯转发）
PROXY_FULL_STACK=0

# ── 腾讯记忆 · 端口 ─────────────────────────────────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── 腾讯记忆 · knowledge 对外可达地址（必须含 /v3）──────────────────────────
# 默认 host.docker.internal 供容器内回环到宿主机；公网/跨机部署改成真实地址
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3
# Panel UI "客户端接入地址"卡片显示的地址。留空 = deploy.sh 自动探测宿主机 LAN IP；
# 想显式指定（公网域名/特定网卡）就取消注释填真值：
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.1.100:8096

# ── 腾讯记忆 · 内部凭据 ─────────────────────────────────────────────────────
# 留空（默认）：memory-core 关闭 Bearer gate；memory-hub / memory-proxy 自动用 "local"。
#               因 proxy 源码兼容性，不建议设为非空。
MEMORY_CORE_GATEWAY_API_KEY=
# admin 用户名；user_key 由 deploy.sh 首次启动自动生成随机 sk-mem-* 并存到 .admin-key
MEMORY_CORE_ADMIN_USERNAME=admin
