# ============================================================
# llmops 部署配置（复制为 .env 并填写真实值；.env 已在 .gitignore 中）
#
# ⚠️ 本模板面向「对接 deploy/base 基础环境」模式：db / redis / weaviate 由
#    deploy/base 提供（Docker 网络 base-net，服务名 db / redis / weaviate），
#    下面的 host 已指向这些服务名；应用容器须加入 base-net 网络（见
#    deploy/docker-compose.yaml 底部 networks 段）。
#    独立部署（无 base 环境）时，把 db/redis/weaviate 改回 llmops-db /
#    llmops-redis / llmops-weaviate 并自建对应服务。
#
# 配置优先级：system_config（DB /settings 页面）> 本文件环境变量 > 代码默认值
# 分层说明：
#   【必须】= 基础设施，容器编排/启动即依赖，务必在本文件填写
#   【可选】= 业务配置（LLM/第三方 Key），可留空后用 /settings 页面配置；
#            建议填写一份初始值作为兜底（首次启动、DB 故障时可用）
# ============================================================

# ── 基础（必须）──
MODE=api
# Agent 事件使用 Redis Stream，图状态使用 Postgres checkpointer；多 worker 前确保两者可用。
# 开发环境未启动 Redis/Postgres 时保持 1，避免退回进程内状态。
SERVER_WORKER_AMOUNT=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SERVER_THREAD_AMOUNT=4
MIGRATION_ENABLED=true

# ── JWT 加密密钥（必须，生产必须改为随机 32+ 位字符串）──
JWT_SECRET_KEY=change-me-to-a-random-32-char-string
WTF_CSRF_ENABLED=false

# MCP 与 OpenTelemetry（默认关闭）
MCP_ENABLED=false
MCP_SERVERS_JSON=[]
MCP_ALLOWED_ACCOUNT_IDS=
MCP_TIMEOUT_S=30
MCP_SERVER_ENABLED=false
MCP_PUBLIC_URL=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=llmops
OTEL_EXPORTERS=console
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── PostgreSQL（必须：DB 连接是最先依赖的底座，system_config 存在 DB 里）──
# 账号密码需与 deploy/base/.env 的 POSTGRES_* 一致（默认 postgres/123456/llmdb）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=llmdb
SQLALCHEMY_DATABASE_URI=postgresql://postgres:123456@db:5432/llmdb?client_encoding=utf8&options=-csearch_path=llmops
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=true

# ── Redis / Celery（必须）──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_USE_SSL=false
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=true
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CELERY_POOL=threads
CELERY_WORKER_AMOUNT=4

# ── Weaviate（必须：API Key 与 deploy/base/.env 的 WEAVIATE_API_KEY 一致，用于 base 环境 weaviate 容器认证）──
WEAVIATE_HTTP_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=change-me-weaviate-key

# ── 嵌入/重排/查询改写（T13⑲：settings 新增字段；本地模型需挂载模型目录，API 型填 Key）──
# 嵌入：local（默认，bge-small-zh + embedding_device）| openai | dashscope | ...
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-small-zh
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
# 重排：rerank_device 默认 cpu（本地 bge-reranker）或 API 型
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_DEVICE=cpu
RERANK_API_KEY=
RERANK_API_BASE=
# 查询改写模型（agentic 检索多轮重检用，缺省回退主 LLM）
QUERY_REWRITE_MODEL=

# ── 文件存储（必须：cos | miniio 二选一）──
STORAGE_PROVIDER=miniio
# MiniIO（mall-third-party）模式
MINIO_API_URL=http://localhost:88/api
MINIO_TIMEOUT=60
# 腾讯云 COS 模式（STORAGE_PROVIDER=cos 时填写；也可用 /settings 页面的"对象存储"）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=
# 语音服务：音频转写拼接的 COS 基础地址（可留空，默认 https://{bucket}.cos.{region}.myqcloud.com/）
COS_BASE_URL=

# ────────────────────────────────────────────────────────────
# 【可选】业务配置：以下均可留空，登录后到 /settings 页面配置
# （DB 优先：页面保存后重启即覆盖本文件值；DB 中清空该项则回退本文件）
# 建议填写一份可用初始值，作为首次启动与 DB 故障时的兜底
# ────────────────────────────────────────────────────────────

# ── LLM API Keys（可选，推荐用 /settings → 大模型配置）──
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.cn
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
# 语音服务：文字转语音（TTS）接口完整地址（可留空，默认 https://dashscope.aliyuncs.com/api/v1）
DASHSCOPE_BASE_HTTP_API_URL=
# 第三方集成 / 内置工具端点（可留空，使用系统设置默认值）
BROWSER_LLM_BASE_URL=
BROWSER_ALLOWED_DOMAINS=
BROWSER_BLOCK_IP_ADDRESSES=true
TOOL_HTTP_ALLOWED_HOSTS=
SKILL_EXECUTABLE_ENABLED=false
SKILL_TOOL_TIMEOUT=60
GAODE_API_DOMAIN=
FEISHU_OPEN_API_BASE=
GITHUB_OAUTH_BASE_URL=
GITHUB_API_BASE_URL=

# ── 第三方集成（可选，推荐用 /settings → 第三方集成）──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_REDIRECT_URI=http://localhost:5173/auth/authorize/github
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llmops
GAODE_API_KEY=
ASSISTANT_AGENT_ID=

# ── 飞书机器人（可选，推荐用 /settings → 飞书机器人）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
LLMOPS_APP_ID=
LLMOPS_ACCESS_TOKEN=

# ── 配置加密主密钥（必须：/settings 保存的敏感配置用它 AES 加密；缺省回退 JWT_SECRET_KEY）──
# 生产环境务必单独设置一个随机值（与 JWT_SECRET_KEY 不同，防止 JWT 泄露导致配置密文可解）
CONFIG_MASTER_KEY=change-me-to-another-random-32-char-string
